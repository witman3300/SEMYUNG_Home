# ===== 세명장교 비즈니스센터 — 환경변수 =====
# 로컬: backend/.env 로 복사 후 값 입력 / Railway: 대시보드 Variables 에 등록

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-5          # 비용 절감 시 claude-haiku-4-5 등
CLAUDE_EFFORT=low                     # 응답 깊이/토큰 소모: low|medium|high|xhigh|max

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...   # 서버 전용, 절대 프론트 노출 금지
SUPABASE_ANON_KEY=eyJ...anon(public)...      # 관리자 로그인(Supabase Auth)·프론트용(공개 가능)

# --- 관리자 (/admin) : Supabase Auth 사용 ---
# Supabase Dashboard → Authentication → Users 에서 관리자 계정 생성
ADMIN_EMAIL=admin@semyung.co.kr        # (선택) 이 이메일만 관리자 허용. 비우면 인증된 모든 사용자 허용
TARGET_CUSTOMERS=1000                  # 진척률 목표치

# --- 카카오 채널 ---
KAKAO_CHANNEL_URL=https://pf.kakao.com/_your_channel

# --- 회원 소셜 로그인 ---
# 구글·카카오: 코드 수정 없이 Supabase Dashboard에서 켜면 된다.
#   Authentication → Providers → Google / Kakao 활성화 후 각 개발자 콘솔의 Client ID·Secret 입력.
#   각 콘솔의 승인 리디렉션 주소: https://<프로젝트>.supabase.co/auth/v1/callback
# 네이버: Supabase가 지원하지 않아 서버(/api/auth/naver/*)가 직접 처리한다.
#   네이버 개발자센터(developers.naver.com) → 애플리케이션 등록 →
#   사용 API '네이버 로그인', 제공 정보에 '이메일' 필수 체크(없으면 가입 불가),
#   서비스 URL https://semyung.co.kr / Callback URL 아래 주소와 동일하게 등록.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://semyung.co.kr/api/auth/naver/callback
PUBLIC_BASE_URL=https://semyung.co.kr   # 네이버 콜백 주소 기본값 계산에 사용

# --- 문의 자동이메일(SMTP, 선택) ---
SMTP_HOST=smtp.gmail.com               # 예: Gmail. 미설정 시 이메일 전송 생략
SMTP_PORT=587                          # 465=SSL, 587=STARTTLS
SMTP_USER=your@gmail.com
SMTP_PASS=app-password                 # Gmail은 앱 비밀번호
MAIL_FROM=your@gmail.com
MAIL_TO=owner@semyung.co.kr            # 문의 수신 이메일

# --- CORS / PORT ---
ALLOWED_ORIGINS=*
# PORT=8000  (Railway 자동 주입)
